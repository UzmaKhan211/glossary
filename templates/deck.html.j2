<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<link rel="stylesheet" href="fonts.css">
<style>{{ grade_css }}</style>
<link rel="stylesheet" href="style.css">
</head>
<body>
{% for pair in pages %}
<div class="sheet">
  {% set card = pair[0] %}
  <div class="card grade-{{ card.grade }}">
    {% include "card_body.html.j2" %}
  </div>

  <div class="cut-line">
    <div class="line"></div>
    <div class="label">&#9986; cut here</div>
    <div class="line"></div>
  </div>

  {% if pair[1] %}
    {% set card = pair[1] %}
    <div class="card grade-{{ card.grade }}">
      {% include "card_body.html.j2" %}
    </div>
  {% else %}
    <div class="card empty"></div>
  {% endif %}
</div>
{% endfor %}
</body>
</html>
