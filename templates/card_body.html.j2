<div class="card-header">{{ card.word }}</div>
<div class="card-body-row">
  {% if card.text %}<div class="card-text">{{ card.text_html | default(card.text, true) | safe }}</div>{% endif %}
  {% if card.image_uri %}
  <div class="card-image-wrap">
    <img src="{{ card.image_uri }}" alt="">
  </div>
  {% endif %}
</div>
<div class="card-footer">
  <img class="footer-logo" src="amplify-logo.png" alt="Amplify.">
</div>
